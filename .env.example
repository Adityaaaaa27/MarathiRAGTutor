# ============================================================
# Marathi RAG Tutor — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================

# --- Mistral AI ---
# Obtain your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# --- HuggingFace (for embeddings via API) ---
# Obtain a FREE token from: https://huggingface.co/settings/tokens
HF_API_KEY=your_hf_api_key_here

# --- Embedding Mode ---
# "api"   = Use HuggingFace Inference API (no model download, recommended)
# "local" = Download model locally (~2.3 GB)
EMBEDDING_MODE=api

# --- Model Configuration (optional overrides) ---
# MISTRAL_MODEL_NAME=mistral-large-latest
# MISTRAL_TEMPERATURE=0.3

# --- Embedding Model (optional override) ---
# EMBEDDING_MODEL_NAME=BAAI/bge-m3

# --- Retrieval (optional override) ---
# RETRIEVER_TOP_K=5

# --- Paths (optional overrides) ---
# PDF_PATH=data/textbook.pdf
# CHROMA_PERSIST_DIR=chroma
# LOG_DIR=logs
